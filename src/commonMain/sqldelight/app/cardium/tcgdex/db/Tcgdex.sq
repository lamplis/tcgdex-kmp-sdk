-- =============================================================================
-- TCGdex Offline Database Schema
-- =============================================================================
-- This schema stores a multi-language snapshot of the TCGdex card catalog.
-- Each entity (series, sets, cards) is stored per-language, allowing the app
-- to query localized names and image URLs at runtime without network access.
--
-- Key design decisions:
-- 1. Composite primary keys (id, language) allow the same logical entity to
--    exist in multiple languages.
-- 2. Image URLs are language-specific (TCGdex assets use language in the path).
-- 3. Illustrators and rarities are language-agnostic (names are in original form).
-- =============================================================================

-- -----------------------------------------------------------------------------
-- Series table: Top-level groupings of sets (e.g., "Scarlet & Violet", "Sword & Shield")
-- -----------------------------------------------------------------------------
CREATE TABLE series (
    id TEXT NOT NULL,
    language TEXT NOT NULL,
    name TEXT NOT NULL,
    position INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (id, language)
);

CREATE INDEX series_language_idx ON series(language);

-- -----------------------------------------------------------------------------
-- Sets table: Individual card sets within a series
-- -----------------------------------------------------------------------------
CREATE TABLE sets (
    id TEXT NOT NULL,
    language TEXT NOT NULL,
    serie_id TEXT NOT NULL,
    name TEXT NOT NULL,
    logo_url TEXT,
    symbol_url TEXT,
    card_count_total INTEGER NOT NULL,
    card_count_official INTEGER NOT NULL,
    release_date TEXT,
    PRIMARY KEY (id, language),
    FOREIGN KEY (serie_id, language) REFERENCES series(id, language) ON DELETE CASCADE
);

CREATE INDEX sets_serie_id_idx ON sets(serie_id, language);
CREATE INDEX sets_language_idx ON sets(language);
CREATE INDEX sets_release_date_idx ON sets(release_date);

-- -----------------------------------------------------------------------------
-- Illustrators table: Card artists (language-agnostic, original names)
-- -----------------------------------------------------------------------------
CREATE TABLE illustrators (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL
);

-- -----------------------------------------------------------------------------
-- Rarities table: Card rarity classifications (language-agnostic slugs)
-- -----------------------------------------------------------------------------
CREATE TABLE rarities (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL
);

-- -----------------------------------------------------------------------------
-- Cards table: Individual cards with localized names and image URLs
-- -----------------------------------------------------------------------------
-- Pricing columns store embedded Cardmarket EUR snapshot (generated at build time):
-- - price_cardmarket_trend: Cardmarket trend price in EUR (primary display price)
-- - price_cardmarket_avg: Cardmarket average sell price in EUR
-- - price_cardmarket_low: Cardmarket low price in EUR
-- - price_updated_iso: ISO 8601 timestamp when price was fetched from Cardmarket
-- - price_unit: Currency unit (always "EUR" for Cardmarket)
-- -----------------------------------------------------------------------------
CREATE TABLE cards (
    id TEXT NOT NULL,
    language TEXT NOT NULL,
    local_id TEXT NOT NULL,
    local_number_sort INTEGER NOT NULL DEFAULT 0,
    set_id TEXT NOT NULL,
    rarity_id TEXT REFERENCES rarities(id),
    illustrator_id TEXT REFERENCES illustrators(id),
    name TEXT NOT NULL,
    image_url TEXT,
    fallback_image_url TEXT,
    fallback_image_source TEXT,
    origin_language TEXT,
    category TEXT,
    types TEXT,
    supertype TEXT,
    regulation_mark TEXT,
    -- Embedded Cardmarket EUR pricing snapshot
    price_cardmarket_trend REAL,
    price_cardmarket_avg REAL,
    price_cardmarket_low REAL,
    price_updated_iso TEXT,
    price_unit TEXT,
    PRIMARY KEY (id, language),
    FOREIGN KEY (set_id, language) REFERENCES sets(id, language) ON DELETE CASCADE
);

CREATE INDEX cards_set_idx ON cards(set_id, language);
CREATE INDEX cards_language_idx ON cards(language);
CREATE INDEX cards_illustrator_idx ON cards(illustrator_id);
CREATE INDEX cards_rarity_idx ON cards(rarity_id);
CREATE INDEX cards_name_idx ON cards(name);

-- -----------------------------------------------------------------------------
-- Card-Pokémon junction table: Links cards to one or more Pokédex IDs
-- Supports multi-Pokémon cards (TAG TEAMs, Buried Fossil, etc.)
-- -----------------------------------------------------------------------------
CREATE TABLE card_pokemon (
    card_id TEXT NOT NULL,
    language TEXT NOT NULL,
    pokemon_dex_id INTEGER NOT NULL,
    PRIMARY KEY (card_id, language, pokemon_dex_id),
    FOREIGN KEY (card_id, language) REFERENCES cards(id, language) ON DELETE CASCADE
);

CREATE INDEX card_pokemon_dex_idx ON card_pokemon(pokemon_dex_id, language);
CREATE INDEX card_pokemon_card_idx ON card_pokemon(card_id, language);

-- -----------------------------------------------------------------------------
-- Pokémon Species table: Canonical species names from the official Pokédex
-- Provides localized names independent of card titles (avoids TAG TEAM naming issues)
-- Includes evolution chain data (evolvesFrom/evolvesTo as dexIds)
-- -----------------------------------------------------------------------------
CREATE TABLE pokemon_species (
    dex_id INTEGER NOT NULL,
    language TEXT NOT NULL,
    name TEXT NOT NULL,
    evolves_from INTEGER,  -- dexId of the species this Pokémon evolves from (null if base form)
    evolves_to TEXT,       -- Comma-separated dexIds this Pokémon can evolve into (empty if final form)
    PRIMARY KEY (dex_id, language)
);

CREATE INDEX pokemon_species_dex_idx ON pokemon_species(dex_id);
CREATE INDEX pokemon_species_evolves_from_idx ON pokemon_species(evolves_from);

-- -----------------------------------------------------------------------------
-- View: card_with_set - Denormalized view joining cards with their set and series
-- Used by most card queries to avoid repeated joins.
-- Note: Does NOT include pokemon_dex_id - use card_with_pokemon view for Pokédex queries
-- Includes embedded Cardmarket EUR pricing snapshot columns.
-- -----------------------------------------------------------------------------
CREATE VIEW card_with_set AS
SELECT
    cards.id,
    cards.language,
    cards.local_id,
    cards.local_number_sort,
    cards.set_id,
    cards.name,
    cards.image_url,
    cards.fallback_image_url,
    cards.fallback_image_source,
    cards.origin_language,
    cards.rarity_id,
    rarities.name AS rarity_name,
    cards.illustrator_id,
    illustrators.name AS illustrator_name,
    cards.category,
    cards.types,
    cards.supertype,
    cards.regulation_mark,
    cards.price_cardmarket_trend,
    cards.price_cardmarket_avg,
    cards.price_cardmarket_low,
    cards.price_updated_iso,
    cards.price_unit,
    sets.card_count_official AS set_card_count_official,
    sets.card_count_total AS set_card_count_total,
    sets.name AS set_name,
    sets.logo_url AS set_logo_url,
    sets.symbol_url AS set_symbol_url,
    sets.serie_id,
    series.name AS serie_name,
    sets.release_date AS set_release_date
FROM cards
INNER JOIN sets ON sets.id = cards.set_id AND sets.language = cards.language
INNER JOIN series ON series.id = sets.serie_id AND series.language = sets.language
LEFT JOIN illustrators ON illustrators.id = cards.illustrator_id
LEFT JOIN rarities ON rarities.id = cards.rarity_id;

-- -----------------------------------------------------------------------------
-- View: card_with_pokemon - Cards joined with their Pokédex IDs via junction table
-- Used for Pokédex queries where a card may appear multiple times (once per dex ID)
-- Includes embedded Cardmarket EUR pricing snapshot columns.
-- -----------------------------------------------------------------------------
CREATE VIEW card_with_pokemon AS
SELECT
    cards.id,
    cards.language,
    cards.local_id,
    cards.local_number_sort,
    cards.set_id,
    cards.name,
    cards.image_url,
    cards.fallback_image_url,
    cards.fallback_image_source,
    cards.origin_language,
    cards.rarity_id,
    rarities.name AS rarity_name,
    cards.illustrator_id,
    illustrators.name AS illustrator_name,
    card_pokemon.pokemon_dex_id,
    cards.category,
    cards.types,
    cards.supertype,
    cards.regulation_mark,
    cards.price_cardmarket_trend,
    cards.price_cardmarket_avg,
    cards.price_cardmarket_low,
    cards.price_updated_iso,
    cards.price_unit,
    sets.card_count_official AS set_card_count_official,
    sets.card_count_total AS set_card_count_total,
    sets.name AS set_name,
    sets.logo_url AS set_logo_url,
    sets.symbol_url AS set_symbol_url,
    sets.serie_id,
    series.name AS serie_name,
    sets.release_date AS set_release_date
FROM cards
INNER JOIN card_pokemon ON card_pokemon.card_id = cards.id AND card_pokemon.language = cards.language
INNER JOIN sets ON sets.id = cards.set_id AND sets.language = cards.language
INNER JOIN series ON series.id = sets.serie_id AND series.language = sets.language
LEFT JOIN illustrators ON illustrators.id = cards.illustrator_id
LEFT JOIN rarities ON rarities.id = cards.rarity_id;

-- =============================================================================
-- INSERT STATEMENTS
-- =============================================================================

insertSerie:
INSERT OR REPLACE INTO series(id, language, name, position)
VALUES (:id, :language, :name, :position);

insertSet:
INSERT OR REPLACE INTO sets(
    id,
    language,
    serie_id,
    name,
    logo_url,
    symbol_url,
    card_count_total,
    card_count_official,
    release_date
)
VALUES (
    :id,
    :language,
    :serieId,
    :name,
    :logoUrl,
    :symbolUrl,
    :cardCountTotal,
    :cardCountOfficial,
    :releaseDate
);

insertIllustrator:
INSERT OR REPLACE INTO illustrators(id, name)
VALUES (:id, :name);

insertRarity:
INSERT OR REPLACE INTO rarities(id, name)
VALUES (:id, :name);

insertCard:
INSERT OR REPLACE INTO cards(
    id,
    language,
    local_id,
    local_number_sort,
    set_id,
    rarity_id,
    illustrator_id,
    name,
    image_url,
    fallback_image_url,
    fallback_image_source,
    origin_language,
    category,
    types,
    supertype,
    regulation_mark,
    price_cardmarket_trend,
    price_cardmarket_avg,
    price_cardmarket_low,
    price_updated_iso,
    price_unit
)
VALUES (
    :id,
    :language,
    :localId,
    :localNumberSort,
    :setId,
    :rarityId,
    :illustratorId,
    :name,
    :imageUrl,
    :fallbackImageUrl,
    :fallbackImageSource,
    :originLanguage,
    :category,
    :types,
    :supertype,
    :regulationMark,
    :priceCardmarketTrend,
    :priceCardmarketAvg,
    :priceCardmarketLow,
    :priceUpdatedIso,
    :priceUnit
);

-- Insert a card-Pokémon relationship (call once per dex ID for multi-Pokémon cards)
insertCardPokemon:
INSERT OR REPLACE INTO card_pokemon(card_id, language, pokemon_dex_id)
VALUES (:cardId, :language, :pokemonDexId);

-- Insert a Pokémon species canonical name with evolution chain
insertPokemonSpecies:
INSERT OR REPLACE INTO pokemon_species(dex_id, language, name, evolves_from, evolves_to)
VALUES (:dexId, :language, :name, :evolvesFrom, :evolvesTo);

-- =============================================================================
-- SERIES QUERIES
-- =============================================================================

-- Get all series for a specific language, ordered by position
getAllSeriesByLanguage:
SELECT *
FROM series
WHERE language = :language
ORDER BY position ASC, id;

-- Get series by ID and language
getSeriesById:
SELECT *
FROM series
WHERE id = :id AND language = :language;

-- Get all available languages in the database
getAvailableLanguages:
SELECT DISTINCT language FROM series ORDER BY language;

-- Count all sets in the database (for debugging)
countAllSets:
SELECT COUNT(*) FROM sets;

-- Count sets by language (for debugging)
countSetsByLanguage:
SELECT COUNT(*) FROM sets WHERE language = :language;

-- =============================================================================
-- SET QUERIES
-- =============================================================================

-- Get all sets for a specific language
getAllSetsByLanguage:
SELECT *
FROM sets
WHERE language = :language
ORDER BY release_date DESC, id;

-- Get sets for a specific series and language
getSetsForSerie:
SELECT *
FROM sets
WHERE serie_id = :serieId AND language = :language
ORDER BY release_date DESC, card_count_official DESC, id;

-- Get a specific set by ID and language
getSetById:
SELECT *
FROM sets
WHERE id = :id AND language = :language;

-- Get set with series name for display
getSetWithSerieName:
SELECT
    sets.*,
    series.name AS serie_name
FROM sets
INNER JOIN series ON series.id = sets.serie_id AND series.language = sets.language
WHERE sets.id = :id AND sets.language = :language;

-- =============================================================================
-- CARD QUERIES
-- =============================================================================

-- Get all cards for a set (with denormalized view)
getCardsForSet:
SELECT *
FROM card_with_set
WHERE set_id = :setId AND language = :language
ORDER BY local_number_sort, local_id;

-- Get cards by illustrator (across all sets in a language)
getCardsForIllustrator:
SELECT *
FROM card_with_set
WHERE illustrator_id = :illustratorId AND language = :language
ORDER BY set_release_date DESC, set_id, local_number_sort, local_id;

-- Get cards by rarity
getCardsForRarity:
SELECT *
FROM card_with_set
WHERE rarity_id = :rarityId AND language = :language
ORDER BY set_release_date DESC, set_id, local_number_sort, local_id;

-- Get cards by Pokédex ID (uses junction table for multi-Pokémon support)
getCardsForDexId:
SELECT *
FROM card_with_pokemon
WHERE pokemon_dex_id = :dexId AND language = :language
ORDER BY set_release_date DESC, set_id, local_number_sort, local_id;

-- Get a specific card by ID and language
getCardById:
SELECT *
FROM card_with_set
WHERE id = :id AND language = :language;

-- Search cards by name (case-insensitive partial match)
searchCardsByName:
SELECT *
FROM card_with_set
WHERE language = :language AND lower(name) LIKE '%' || lower(:query) || '%'
ORDER BY name, set_release_date DESC, local_number_sort, local_id
LIMIT :limit OFFSET :offset;

-- Count cards matching a name search
countCardsByName:
SELECT COUNT(*)
FROM cards
WHERE language = :language AND lower(name) LIKE '%' || lower(:query) || '%';

-- =============================================================================
-- ILLUSTRATOR & RARITY QUERIES
-- =============================================================================

-- Get all illustrators (language-agnostic)
getAllIllustrators:
SELECT *
FROM illustrators
ORDER BY name;

-- Get illustrator by ID
getIllustratorById:
SELECT *
FROM illustrators
WHERE id = :id;

-- Get all rarities (language-agnostic)
getAllRarities:
SELECT *
FROM rarities
ORDER BY name;

-- Get rarity by ID
getRarityById:
SELECT *
FROM rarities
WHERE id = :id;

-- Count cards per illustrator (for a specific language)
countCardsPerIllustrator:
SELECT
    illustrators.id,
    illustrators.name,
    COUNT(cards.id) AS card_count
FROM illustrators
LEFT JOIN cards ON cards.illustrator_id = illustrators.id AND cards.language = :language
GROUP BY illustrators.id, illustrators.name
HAVING card_count > 0
ORDER BY card_count DESC, illustrators.name;

-- =============================================================================
-- POKÉMON DEX QUERIES (Pokédex collection support)
-- Uses card_with_pokemon view to support multi-Pokémon cards (TAG TEAMs, etc.)
-- =============================================================================

-- Get all unique Pokémon dex IDs with card counts and evolution data for a language
-- Returns: dexId, canonical species name (from pokemon_species table), total card count, evolution chain
-- Excludes TCGP (TCG Pocket) cards via serie_id filter
-- Note: A card with multiple dex IDs (e.g., TAG TEAM) is counted once per dex ID
-- Note: Uses COALESCE to fall back to card name if species table is missing entry
getAllPokemonDexIds:
SELECT
    cwp.pokemon_dex_id AS dex_id,
    COALESCE(ps.name, MIN(cwp.name)) AS pokemon_name,
    COUNT(*) AS card_count,
    ps.evolves_from,
    ps.evolves_to
FROM card_with_pokemon cwp
LEFT JOIN pokemon_species ps ON ps.dex_id = cwp.pokemon_dex_id AND ps.language = cwp.language
WHERE cwp.pokemon_dex_id IS NOT NULL
    AND cwp.language = :language
    AND cwp.serie_id != 'tcgp'
GROUP BY cwp.pokemon_dex_id
ORDER BY cwp.pokemon_dex_id ASC;

-- Get all card IDs grouped by Pokémon dex ID
-- Used for computing owned card counts in the Pokédex list
-- Excludes TCGP (TCG Pocket) cards
getAllCardIdsByPokemon:
SELECT
    pokemon_dex_id AS dex_id,
    id AS card_id
FROM card_with_pokemon
WHERE pokemon_dex_id IS NOT NULL
    AND language = :language
    AND serie_id != 'tcgp'
ORDER BY pokemon_dex_id ASC;

-- Get a Pokémon species by dex ID with evolution data
-- Returns: name, evolvesFrom, evolvesTo for the specified dexId and language
getPokemonSpeciesByDexId:
SELECT
    dex_id,
    name,
    evolves_from,
    evolves_to
FROM pokemon_species
WHERE dex_id = :dexId AND language = :language;

-- Get card counts per set for a specific Pokémon (for gallery grouping)
-- Returns: setId, setName, releaseDate, serieId, serieName, logoUrl, cardCount
getCardCountsPerSetForDexId:
SELECT
    set_id,
    set_name,
    set_release_date AS release_date,
    serie_id,
    serie_name,
    set_logo_url AS logo_url,
    set_symbol_url AS symbol_url,
    COUNT(*) AS card_count
FROM card_with_pokemon
WHERE pokemon_dex_id = :dexId
    AND language = :language
    AND serie_id != 'tcgp'
GROUP BY set_id, set_name, set_release_date, serie_id, serie_name, set_logo_url, set_symbol_url
ORDER BY set_release_date DESC, set_id;

-- Get all cards for a Pokémon in a specific set (for gallery rendering)
getCardsForDexIdInSet:
SELECT *
FROM card_with_pokemon
WHERE pokemon_dex_id = :dexId
    AND set_id = :setId
    AND language = :language
    AND serie_id != 'tcgp'
ORDER BY local_number_sort, local_id;

-- Get Pokémon dex ID for a specific card (reverse lookup for species)
-- Returns the first dex ID associated with the card (multi-Pokémon cards may have several)
-- Used by dashboard stats to resolve species from owned card IDs
getDexIdForCard:
SELECT pokemon_dex_id
FROM card_with_pokemon
WHERE id = :cardId
    AND language = :language
    AND pokemon_dex_id IS NOT NULL
LIMIT 1;

-- =============================================================================
-- LOCAL ID / REFERENCE SEARCH QUERIES
-- Used for numeric reference searches like "001/165", "sv08-001", "sv08 001"
-- =============================================================================

-- Search cards by local_id (exact match, across all sets)
-- Excludes TCGP cards
searchCardsByLocalId:
SELECT *
FROM card_with_set
WHERE language = :language
    AND local_id = :localId
    AND serie_id != 'tcgp'
ORDER BY set_release_date DESC, set_id, local_number_sort
LIMIT :limit;

-- Search cards by local_id within a specific set
-- Excludes TCGP cards
searchCardsByLocalIdInSet:
SELECT *
FROM card_with_set
WHERE language = :language
    AND set_id = :setId
    AND local_id = :localId
    AND serie_id != 'tcgp'
ORDER BY local_number_sort;

-- Find sets by official card count (for matching "X/Y" format where Y is the count)
-- Excludes TCGP sets
findSetsByCardCount:
SELECT *
FROM sets
INNER JOIN series ON series.id = sets.serie_id AND series.language = sets.language
WHERE sets.language = :language
    AND sets.card_count_official = :cardCount
    AND sets.serie_id != 'tcgp'
ORDER BY sets.release_date DESC;

-- Search cards by local_id within sets matching a specific card count
-- Used for "001/165" format searches
-- Excludes TCGP cards
searchCardsByLocalIdAndCardCount:
SELECT cws.*
FROM card_with_set cws
INNER JOIN sets s ON s.id = cws.set_id AND s.language = cws.language
WHERE cws.language = :language
    AND cws.local_id = :localId
    AND s.card_count_official = :cardCount
    AND cws.serie_id != 'tcgp'
ORDER BY cws.set_release_date DESC, cws.set_id, cws.local_number_sort
LIMIT :limit;

-- Search sets by name (partial match, for "151" matching "Pokémon 151")
-- Excludes TCGP sets
searchSetsByName:
SELECT
    sets.*,
    series.name AS serie_name
FROM sets
INNER JOIN series ON series.id = sets.serie_id AND series.language = sets.language
WHERE sets.language = :language
    AND lower(sets.name) LIKE '%' || lower(:query) || '%'
    AND sets.serie_id != 'tcgp'
ORDER BY sets.release_date DESC
LIMIT :limit;
