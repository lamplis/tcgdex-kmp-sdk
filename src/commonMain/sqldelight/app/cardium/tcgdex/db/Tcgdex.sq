-- =============================================================================
-- TCGdex Offline Database Schema
-- =============================================================================
-- This schema stores a multi-language snapshot of the TCGdex card catalog.
-- Each entity (series, sets, cards) is stored per-language, allowing the app
-- to query localized names and image URLs at runtime without network access.
--
-- Key design decisions:
-- 1. Composite primary keys (id, language) allow the same logical entity to
--    exist in multiple languages.
-- 2. Image URLs are language-specific (TCGdex assets use language in the path).
-- 3. Illustrators and rarities are language-agnostic (names are in original form).
-- =============================================================================

-- -----------------------------------------------------------------------------
-- Series table: Top-level groupings of sets (e.g., "Scarlet & Violet", "Sword & Shield")
-- -----------------------------------------------------------------------------
CREATE TABLE series (
    id TEXT NOT NULL,
    language TEXT NOT NULL,
    name TEXT NOT NULL,
    position INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (id, language)
);

CREATE INDEX series_language_idx ON series(language);

-- -----------------------------------------------------------------------------
-- Sets table: Individual card sets within a series
-- -----------------------------------------------------------------------------
CREATE TABLE sets (
    id TEXT NOT NULL,
    language TEXT NOT NULL,
    serie_id TEXT NOT NULL,
    name TEXT NOT NULL,
    logo_url TEXT,
    symbol_url TEXT,
    card_count_total INTEGER NOT NULL,
    card_count_official INTEGER NOT NULL,
    release_date TEXT,
    PRIMARY KEY (id, language),
    FOREIGN KEY (serie_id, language) REFERENCES series(id, language) ON DELETE CASCADE
);

CREATE INDEX sets_serie_id_idx ON sets(serie_id, language);
CREATE INDEX sets_language_idx ON sets(language);
CREATE INDEX sets_release_date_idx ON sets(release_date);

-- -----------------------------------------------------------------------------
-- Illustrators table: Card artists (language-agnostic, original names)
-- -----------------------------------------------------------------------------
CREATE TABLE illustrators (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL
);

-- -----------------------------------------------------------------------------
-- Rarities table: Card rarity classifications (language-agnostic slugs)
-- -----------------------------------------------------------------------------
CREATE TABLE rarities (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL
);

-- -----------------------------------------------------------------------------
-- Cards table: Individual cards with localized names and image URLs
-- -----------------------------------------------------------------------------
-- Pricing columns store embedded Cardmarket EUR snapshot (generated at build time):
-- - price_cardmarket_trend: Cardmarket trend price in EUR (primary display price)
-- - price_cardmarket_avg: Cardmarket average sell price in EUR
-- - price_cardmarket_low: Cardmarket low price in EUR
-- - price_updated_iso: ISO 8601 timestamp when price was fetched from Cardmarket
-- - price_unit: Currency unit (always "EUR" for Cardmarket)
-- -----------------------------------------------------------------------------
CREATE TABLE cards (
    id TEXT NOT NULL,
    language TEXT NOT NULL,
    local_id TEXT NOT NULL,
    local_number_sort INTEGER NOT NULL DEFAULT 0,
    set_id TEXT NOT NULL,
    rarity_id TEXT REFERENCES rarities(id),
    illustrator_id TEXT REFERENCES illustrators(id),
    name TEXT NOT NULL,
    image_url TEXT,
    fallback_image_url TEXT,
    fallback_image_source TEXT,
    origin_language TEXT,
    category TEXT,
    types TEXT,
    supertype TEXT,
    regulation_mark TEXT,
    hp INTEGER,
    -- Embedded Cardmarket EUR pricing snapshot
    price_cardmarket_trend REAL,
    price_cardmarket_avg REAL,
    price_cardmarket_low REAL,
    price_updated_iso TEXT,
    price_unit TEXT,
    PRIMARY KEY (id, language),
    FOREIGN KEY (set_id, language) REFERENCES sets(id, language) ON DELETE CASCADE
);

CREATE INDEX cards_set_idx ON cards(set_id, language);
CREATE INDEX cards_language_idx ON cards(language);
CREATE INDEX cards_illustrator_idx ON cards(illustrator_id);
CREATE INDEX cards_rarity_idx ON cards(rarity_id);
CREATE INDEX cards_name_idx ON cards(name);
CREATE INDEX IF NOT EXISTS idx_cards_rarity_series ON cards(language, rarity_id);

-- -----------------------------------------------------------------------------
-- Cards FTS table: Accent-insensitive card name search
-- -----------------------------------------------------------------------------
CREATE VIRTUAL TABLE cards_fts USING fts5(
    card_id UNINDEXED,
    language UNINDEXED,
    name,
    tokenize = 'unicode61 remove_diacritics 2'
);

CREATE TRIGGER cards_fts_after_insert
AFTER INSERT ON cards
BEGIN
    INSERT INTO cards_fts(card_id, language, name)
    VALUES (new.id, new.language, new.name);
END;

-- -----------------------------------------------------------------------------
-- Card Prices table: Detailed Cardmarket pricing (variant + language + country + condition)
-- -----------------------------------------------------------------------------
-- This table stores ALL Cardmarket export prices per card, per Cardmarket condition:
-- - variant: e.g. "Normal", "Reverse", "1stEdition" (source-dependent)
-- - price_language: language key of the price entry in the export JSON (e.g. "fr")
-- - seller_country: seller country code (e.g. "FR", "BE")
-- - condition: Cardmarket condition grade (e.g. "NM", "MT", "EX", "GD", "LP", "PL", "PO").
--              Empty string '' is reserved for the GLOBAL price-guide baseline which is
--              condition-agnostic. Raw per-condition storage -- the database never mixes
--              conditions nor falls back between them; that is an app-layer concern.
-- Note: cards table keeps legacy flat pricing columns for backward compatibility.
-- -----------------------------------------------------------------------------
CREATE TABLE card_prices (
    card_id TEXT NOT NULL,
    card_language TEXT NOT NULL,
    variant TEXT NOT NULL DEFAULT '',
    price_language TEXT NOT NULL,
    seller_country TEXT NOT NULL,
    condition TEXT NOT NULL DEFAULT '',
    currency TEXT NOT NULL DEFAULT 'EUR',
    min_price REAL,
    avg_price REAL,
    median_price REAL,
    max_price REAL,
    recommended_price REAL,
    available_count INTEGER,
    product_id INTEGER,
    updated_iso TEXT NOT NULL DEFAULT '',
    PRIMARY KEY (card_id, card_language, variant, price_language, seller_country, condition),
    FOREIGN KEY (card_id, card_language) REFERENCES cards(id, language) ON DELETE CASCADE
);

CREATE INDEX card_prices_lookup_idx ON card_prices(card_id, card_language, seller_country, condition);
CREATE INDEX card_prices_country_updated_idx ON card_prices(seller_country, updated_iso);

-- -----------------------------------------------------------------------------
-- Card recognition hashes table: per-card perceptual hashes for matcher pipeline
-- -----------------------------------------------------------------------------
CREATE TABLE card_recognition_hashes (
    card_id TEXT NOT NULL,
    language TEXT NOT NULL,
    image_source TEXT NOT NULL,
    image_url TEXT NOT NULL,
    lighting TEXT NOT NULL DEFAULT 'original',
    rotation INTEGER NOT NULL DEFAULT 0,
    dhash TEXT NOT NULL,
    phash TEXT NOT NULL,
    -- image_url is part of the PK: one card holds multiple vectors, one per
    -- referential image (pokepedia) and per Cardmarket product/variant print.
    PRIMARY KEY (card_id, language, image_url, lighting, rotation),
    FOREIGN KEY (card_id, language) REFERENCES cards(id, language) ON DELETE CASCADE
);

CREATE INDEX card_recognition_hashes_card_idx ON card_recognition_hashes(card_id, language);
CREATE INDEX card_recognition_hashes_source_idx ON card_recognition_hashes(image_source, language);

-- -----------------------------------------------------------------------------
-- Card-Pokémon junction table: Links cards to one or more Pokédex IDs
-- Supports multi-Pokémon cards (TAG TEAMs, Buried Fossil, etc.)
-- -----------------------------------------------------------------------------
CREATE TABLE card_pokemon (
    card_id TEXT NOT NULL,
    language TEXT NOT NULL,
    pokemon_dex_id INTEGER NOT NULL,
    is_cameo INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (card_id, language, pokemon_dex_id),
    FOREIGN KEY (card_id, language) REFERENCES cards(id, language) ON DELETE CASCADE
);

CREATE INDEX card_pokemon_dex_idx ON card_pokemon(pokemon_dex_id, language);
CREATE INDEX card_pokemon_card_idx ON card_pokemon(card_id, language);

-- -----------------------------------------------------------------------------
-- Pokémon Species table: Canonical species names from the official Pokédex
-- Provides localized names independent of card titles (avoids TAG TEAM naming issues)
-- Includes evolution chain data (evolvesFrom/evolvesTo as dexIds)
-- -----------------------------------------------------------------------------
CREATE TABLE pokemon_species (
    dex_id INTEGER NOT NULL,
    language TEXT NOT NULL,
    name TEXT NOT NULL,
    evolves_from INTEGER,  -- dexId of the species this Pokémon evolves from (null if base form)
    evolves_to TEXT,       -- Comma-separated dexIds this Pokémon can evolve into (empty if final form)
    PRIMARY KEY (dex_id, language)
);

CREATE INDEX pokemon_species_dex_idx ON pokemon_species(dex_id);
CREATE INDEX pokemon_species_evolves_from_idx ON pokemon_species(evolves_from);

-- -----------------------------------------------------------------------------
-- View: card_with_set - Denormalized view joining cards with their set and series
-- Used by most card queries to avoid repeated joins.
-- Note: Does NOT include pokemon_dex_id - use card_with_pokemon view for Pokédex queries
-- Includes embedded Cardmarket EUR pricing snapshot columns.
-- -----------------------------------------------------------------------------
CREATE VIEW card_with_set AS
SELECT
    cards.id,
    cards.language,
    cards.local_id,
    cards.local_number_sort,
    cards.set_id,
    cards.name,
    cards.image_url,
    cards.fallback_image_url,
    cards.fallback_image_source,
    cards.origin_language,
    cards.rarity_id,
    rarities.name AS rarity_name,
    cards.illustrator_id,
    illustrators.name AS illustrator_name,
    cards.category,
    cards.types,
    cards.supertype,
    cards.regulation_mark,
    cards.hp,
    cards.price_cardmarket_trend,
    cards.price_cardmarket_avg,
    cards.price_cardmarket_low,
    cards.price_updated_iso,
    cards.price_unit,
    COALESCE(localized_set.card_count_official, fallback_set.card_count_official) AS set_card_count_official,
    COALESCE(localized_set.card_count_total, fallback_set.card_count_total) AS set_card_count_total,
    COALESCE(localized_set.name, fallback_set.name) AS set_name,
    COALESCE(localized_set.logo_url, fallback_set.logo_url) AS set_logo_url,
    COALESCE(localized_set.symbol_url, fallback_set.symbol_url) AS set_symbol_url,
    COALESCE(localized_set.serie_id, fallback_set.serie_id) AS serie_id,
    COALESCE(localized_series.name, fallback_series.name, COALESCE(localized_set.serie_id, fallback_set.serie_id)) AS serie_name,
    COALESCE(localized_set.release_date, fallback_set.release_date) AS set_release_date
FROM cards
LEFT JOIN sets AS localized_set ON localized_set.id = cards.set_id AND localized_set.language = cards.language
LEFT JOIN sets AS fallback_set ON fallback_set.id = cards.set_id AND fallback_set.language = 'en'
LEFT JOIN series AS localized_series
    ON localized_series.id = COALESCE(localized_set.serie_id, fallback_set.serie_id)
    AND localized_series.language = cards.language
LEFT JOIN series AS fallback_series
    ON fallback_series.id = COALESCE(localized_set.serie_id, fallback_set.serie_id)
    AND fallback_series.language = 'en'
LEFT JOIN illustrators ON illustrators.id = cards.illustrator_id
LEFT JOIN rarities ON rarities.id = cards.rarity_id
WHERE COALESCE(localized_set.id, fallback_set.id) IS NOT NULL;

-- -----------------------------------------------------------------------------
-- View: card_with_pokemon - Cards joined with their Pokédex IDs via junction table
-- Used for Pokédex queries where a card may appear multiple times (once per dex ID)
-- Includes embedded Cardmarket EUR pricing snapshot columns.
-- -----------------------------------------------------------------------------
CREATE VIEW card_with_pokemon AS
SELECT
    cards.id,
    cards.language,
    cards.local_id,
    cards.local_number_sort,
    cards.set_id,
    cards.name,
    cards.image_url,
    cards.fallback_image_url,
    cards.fallback_image_source,
    cards.origin_language,
    cards.rarity_id,
    rarities.name AS rarity_name,
    cards.illustrator_id,
    illustrators.name AS illustrator_name,
    card_pokemon.pokemon_dex_id,
    card_pokemon.is_cameo,
    cards.category,
    cards.types,
    cards.supertype,
    cards.regulation_mark,
    cards.hp,
    cards.price_cardmarket_trend,
    cards.price_cardmarket_avg,
    cards.price_cardmarket_low,
    cards.price_updated_iso,
    cards.price_unit,
    COALESCE(localized_set.card_count_official, fallback_set.card_count_official) AS set_card_count_official,
    COALESCE(localized_set.card_count_total, fallback_set.card_count_total) AS set_card_count_total,
    COALESCE(localized_set.name, fallback_set.name) AS set_name,
    COALESCE(localized_set.logo_url, fallback_set.logo_url) AS set_logo_url,
    COALESCE(localized_set.symbol_url, fallback_set.symbol_url) AS set_symbol_url,
    COALESCE(localized_set.serie_id, fallback_set.serie_id) AS serie_id,
    COALESCE(localized_series.name, fallback_series.name, COALESCE(localized_set.serie_id, fallback_set.serie_id)) AS serie_name,
    COALESCE(localized_set.release_date, fallback_set.release_date) AS set_release_date
FROM cards
INNER JOIN card_pokemon ON card_pokemon.card_id = cards.id AND card_pokemon.language = cards.language
LEFT JOIN sets AS localized_set ON localized_set.id = cards.set_id AND localized_set.language = cards.language
LEFT JOIN sets AS fallback_set ON fallback_set.id = cards.set_id AND fallback_set.language = 'en'
LEFT JOIN series AS localized_series
    ON localized_series.id = COALESCE(localized_set.serie_id, fallback_set.serie_id)
    AND localized_series.language = cards.language
LEFT JOIN series AS fallback_series
    ON fallback_series.id = COALESCE(localized_set.serie_id, fallback_set.serie_id)
    AND fallback_series.language = 'en'
LEFT JOIN illustrators ON illustrators.id = cards.illustrator_id
LEFT JOIN rarities ON rarities.id = cards.rarity_id
WHERE COALESCE(localized_set.id, fallback_set.id) IS NOT NULL;

-- =============================================================================
-- INSERT STATEMENTS
-- =============================================================================

insertSerie:
INSERT OR REPLACE INTO series(id, language, name, position)
VALUES (:id, :language, :name, :position);

insertSet:
INSERT OR REPLACE INTO sets(
    id,
    language,
    serie_id,
    name,
    logo_url,
    symbol_url,
    card_count_total,
    card_count_official,
    release_date
)
VALUES (
    :id,
    :language,
    :serieId,
    :name,
    :logoUrl,
    :symbolUrl,
    :cardCountTotal,
    :cardCountOfficial,
    :releaseDate
);

insertIllustrator:
INSERT OR REPLACE INTO illustrators(id, name)
VALUES (:id, :name);

insertRarity:
INSERT OR REPLACE INTO rarities(id, name)
VALUES (:id, :name);

insertCard:
INSERT OR REPLACE INTO cards(
    id,
    language,
    local_id,
    local_number_sort,
    set_id,
    rarity_id,
    illustrator_id,
    name,
    image_url,
    fallback_image_url,
    fallback_image_source,
    origin_language,
    category,
    types,
    supertype,
    regulation_mark,
    hp,
    price_cardmarket_trend,
    price_cardmarket_avg,
    price_cardmarket_low,
    price_updated_iso,
    price_unit
)
VALUES (
    :id,
    :language,
    :localId,
    :localNumberSort,
    :setId,
    :rarityId,
    :illustratorId,
    :name,
    :imageUrl,
    :fallbackImageUrl,
    :fallbackImageSource,
    :originLanguage,
    :category,
    :types,
    :supertype,
    :regulationMark,
    :hp,
    :priceCardmarketTrend,
    :priceCardmarketAvg,
    :priceCardmarketLow,
    :priceUpdatedIso,
    :priceUnit
);

insertCardPrice:
INSERT OR REPLACE INTO card_prices(
    card_id,
    card_language,
    variant,
    price_language,
    seller_country,
    condition,
    currency,
    min_price,
    avg_price,
    median_price,
    max_price,
    recommended_price,
    available_count,
    product_id,
    updated_iso
)
VALUES (
    :cardId,
    :cardLanguage,
    :variant,
    :priceLanguage,
    :sellerCountry,
    :condition,
    :currency,
    :minPrice,
    :avgPrice,
    :medianPrice,
    :maxPrice,
    :recommendedPrice,
    :availableCount,
    :productId,
    :updatedIso
);

insertCardRecognitionHash:
INSERT OR REPLACE INTO card_recognition_hashes(
    card_id,
    language,
    image_source,
    image_url,
    lighting,
    rotation,
    dhash,
    phash
)
VALUES (
    :cardId,
    :language,
    :imageSource,
    :imageUrl,
    :lighting,
    :rotation,
    :dhash,
    :phash
);

-- Insert a card-Pokémon relationship (call once per dex ID for multi-Pokémon cards)
insertCardPokemon:
INSERT OR REPLACE INTO card_pokemon(card_id, language, pokemon_dex_id, is_cameo)
VALUES (:cardId, :language, :pokemonDexId, :isCameo);

-- Insert a Pokémon species canonical name with evolution chain
insertPokemonSpecies:
INSERT OR REPLACE INTO pokemon_species(dex_id, language, name, evolves_from, evolves_to)
VALUES (:dexId, :language, :name, :evolvesFrom, :evolvesTo);

-- =============================================================================
-- SERIES QUERIES
-- =============================================================================

-- Get all series for a specific language, ordered by position
getAllSeriesByLanguage:
SELECT
    id,
    language,
    name,
    position
FROM series
WHERE language = :language
UNION ALL
SELECT
    id,
    language,
    name,
    position
FROM series
WHERE language = 'en'
  AND id NOT IN (
    SELECT id
    FROM series
    WHERE language = :language
  )
ORDER BY position ASC, id;

-- Get series by ID and language
getSeriesById:
SELECT
    id,
    language,
    name,
    position
FROM series
WHERE id = :id AND language = :language
UNION ALL
SELECT
    id,
    language,
    name,
    position
FROM series
WHERE id = :id
  AND language = 'en'
  AND NOT EXISTS (
    SELECT 1
    FROM series
    WHERE id = :id
      AND language = :language
  )
LIMIT 1;

-- Get all available languages in the database
getAvailableLanguages:
SELECT DISTINCT language FROM series ORDER BY language;

-- Count all sets in the database (for debugging)
countAllSets:
SELECT COUNT(*) FROM sets;

-- Count sets by language (for debugging)
countSetsByLanguage:
SELECT COUNT(*) FROM sets WHERE language = :language;

-- =============================================================================
-- SET QUERIES
-- =============================================================================

-- Get all sets for a specific language
getAllSetsByLanguage:
SELECT
    id,
    language,
    serie_id,
    name,
    logo_url,
    symbol_url,
    card_count_total,
    card_count_official,
    release_date
FROM sets
WHERE language = :language
UNION ALL
SELECT
    id,
    language,
    serie_id,
    name,
    logo_url,
    symbol_url,
    card_count_total,
    card_count_official,
    release_date
FROM sets
WHERE language = 'en'
  AND id NOT IN (
    SELECT id
    FROM sets
    WHERE language = :language
  )
ORDER BY release_date DESC, id;

-- Get sets for a specific series and language
getSetsForSerie:
SELECT
    id,
    language,
    serie_id,
    name,
    logo_url,
    symbol_url,
    card_count_total,
    card_count_official,
    release_date
FROM sets
WHERE serie_id = :serieId AND language = :language
UNION ALL
SELECT
    id,
    language,
    serie_id,
    name,
    logo_url,
    symbol_url,
    card_count_total,
    card_count_official,
    release_date
FROM sets
WHERE serie_id = :serieId
  AND language = 'en'
  AND id NOT IN (
    SELECT id
    FROM sets
    WHERE serie_id = :serieId
      AND language = :language
  )
ORDER BY
  release_date DESC,
  CASE
    WHEN lower(id) LIKE '%promo%'
      OR lower(id) LIKE 'svp%'
      OR lower(id) LIKE '%p'
      OR lower(coalesce(name, '')) LIKE '%promo%'
    THEN 1
    ELSE 0
  END ASC,
  card_count_official DESC,
  id;

-- Get a specific set by ID and language
getSetById:
SELECT
    id,
    language,
    serie_id,
    name,
    logo_url,
    symbol_url,
    card_count_total,
    card_count_official,
    release_date
FROM sets
WHERE id = :id AND language = :language
UNION ALL
SELECT
    id,
    language,
    serie_id,
    name,
    logo_url,
    symbol_url,
    card_count_total,
    card_count_official,
    release_date
FROM sets
WHERE id = :id
  AND language = 'en'
  AND NOT EXISTS (
    SELECT 1
    FROM sets
    WHERE id = :id
      AND language = :language
  )
LIMIT 1;

-- Get set with series name for display
getSetWithSerieName:
WITH effective_set AS (
    SELECT
        id,
        language,
        serie_id,
        name,
        logo_url,
        symbol_url,
        card_count_total,
        card_count_official,
        release_date
    FROM sets
    WHERE id = :id
      AND language = :language
    UNION ALL
    SELECT
        id,
        language,
        serie_id,
        name,
        logo_url,
        symbol_url,
        card_count_total,
        card_count_official,
        release_date
    FROM sets
    WHERE id = :id
      AND language = 'en'
      AND NOT EXISTS (
        SELECT 1
        FROM sets
        WHERE id = :id
          AND language = :language
      )
)
SELECT
    effective_set.id,
    effective_set.language,
    effective_set.serie_id,
    effective_set.name,
    effective_set.logo_url,
    effective_set.symbol_url,
    effective_set.card_count_total,
    effective_set.card_count_official,
    effective_set.release_date,
    COALESCE(localized_series.name, fallback_series.name, effective_set.serie_id) AS serie_name
FROM effective_set
LEFT JOIN series AS localized_series
    ON localized_series.id = effective_set.serie_id
    AND localized_series.language = :language
LEFT JOIN series AS fallback_series
    ON fallback_series.id = effective_set.serie_id
    AND fallback_series.language = 'en'
LIMIT 1;

-- Set IDs that have at least one card in the given language, excluding TCGP sets.
-- Aggregate query used to decide set visibility without loading card lists per set.
getSetIdsWithCards:
SELECT DISTINCT cards.set_id
FROM cards
JOIN sets ON sets.id = cards.set_id AND sets.language = cards.language
WHERE cards.language = :language
  AND lower(sets.serie_id) != 'tcgp';

-- =============================================================================
-- CARD QUERIES
-- =============================================================================

-- Get all cards for a set (with denormalized view)
getCardsForSet:
SELECT *
FROM card_with_set
WHERE set_id = :setId AND language = :language
ORDER BY local_number_sort, local_id;

-- Get cards by illustrator (across all sets in a language)
getCardsForIllustrator:
SELECT *
FROM card_with_set
WHERE illustrator_id = :illustratorId AND language = :language
ORDER BY set_release_date DESC, set_id, local_number_sort, local_id;

-- Get cards by rarity
getCardsForRarity:
SELECT *
FROM card_with_set
WHERE rarity_id = :rarityId AND language = :language
ORDER BY set_release_date DESC, set_id, local_number_sort, local_id;

-- Get cards by Pokédex ID (uses junction table for multi-Pokémon support)
getCardsForDexId:
SELECT *
FROM card_with_pokemon
WHERE pokemon_dex_id = :dexId AND language = :language
ORDER BY set_release_date DESC, set_id, local_number_sort, local_id;

-- Get a specific card by ID and language
getCardById:
SELECT *
FROM card_with_set
WHERE id = :id AND language = :language;

-- Get all detailed prices for a card (all variants/languages/countries)
getCardPrices:
SELECT *
FROM card_prices
WHERE card_id = :cardId
    AND card_language = :cardLanguage
ORDER BY variant, price_language, seller_country;

-- Get every card_prices row for a single card matching the requested seller country
-- (plus the GLOBAL baseline). The database returns raw per-condition rows -- no
-- collapse, no fallback. The app decides which condition to display.
getCardPriceRowsForCard:
SELECT *
FROM card_prices
WHERE card_id = :cardId
    AND card_language = :cardLanguage
    AND (seller_country = :sellerCountry OR seller_country = 'GLOBAL')
ORDER BY
    CASE seller_country WHEN :sellerCountry THEN 0 ELSE 1 END ASC,
    CASE price_language
        WHEN :cardLanguage THEN 0
        WHEN 'fr' THEN 1
        WHEN 'en' THEN 2
        ELSE 3
    END ASC,
    CASE WHEN variant = 'Normal' THEN 0 ELSE 1 END ASC,
    price_language ASC,
    variant ASC,
    condition ASC;

-- Batch variant of getCardPriceRowsForCard. Returns all raw per-condition rows
-- for the given card IDs (country filtered to sellerCountry + GLOBAL).
-- Callers group by card_id and let the app picker decide the displayed price.
getCardPriceRowsByCountry:
SELECT *
FROM card_prices
WHERE card_id IN ?
    AND card_language = :cardLanguage
    AND (seller_country = :sellerCountry OR seller_country = 'GLOBAL')
ORDER BY
    card_id ASC,
    CASE seller_country WHEN :sellerCountry THEN 0 ELSE 1 END ASC,
    CASE price_language
        WHEN :cardLanguage THEN 0
        WHEN 'fr' THEN 1
        WHEN 'en' THEN 2
        ELSE 3
    END ASC,
    CASE WHEN variant = 'Normal' THEN 0 ELSE 1 END ASC,
    price_language ASC,
    variant ASC,
    condition ASC;

-- Get all seller countries present in the database (for account preference dropdown)
getAllSellerCountries:
SELECT DISTINCT seller_country
FROM card_prices
WHERE seller_country != 'GLOBAL'
ORDER BY seller_country ASC;

-- Get the latest price-guide (GLOBAL) update timestamp.
getLatestPriceUpdateIso:
SELECT MAX(price_updated_iso) AS latest_price_update_iso
FROM cards
WHERE price_updated_iso IS NOT NULL
    AND TRIM(price_updated_iso) != '';

-- Get the latest poke-browser export update timestamp.
getLatestExportPriceUpdateIso:
SELECT MAX(updated_iso) AS latest_export_update_iso
FROM card_prices
WHERE seller_country != 'GLOBAL'
    AND updated_iso IS NOT NULL
    AND TRIM(updated_iso) != '';

getCardRecognitionHashesForCard:
SELECT *
FROM card_recognition_hashes
WHERE card_id = :cardId
    AND language = :language
ORDER BY rotation ASC, lighting ASC;

getCardRecognitionHashesForPokemon:
-- Corpus for the scanner rerank. Covers all card categories: the historical
-- category = 'Pokemon' filter also missed accented FR rows ('Pokémon') and
-- excluded Trainer/Energy cards from identification.
SELECT crh.*
FROM card_recognition_hashes crh
INNER JOIN cards c
    ON c.id = crh.card_id
    AND c.language = crh.language
INNER JOIN sets s
    ON s.id = c.set_id
    AND s.language = c.language
WHERE crh.language = :language
    AND s.serie_id != 'tcgp'
ORDER BY crh.card_id ASC, crh.rotation ASC, crh.lighting ASC;

-- Batch lookup for multiple card IDs (used to avoid N+1 queries in UI/use-cases)
getCardsByIds:
SELECT *
FROM card_with_set
WHERE id IN ?
    AND language = :language;

-- Search cards by name (case-insensitive partial match)
searchCardsByName:
SELECT *
FROM card_with_set
WHERE language = :language AND lower(name) LIKE '%' || lower(:query) || '%'
ORDER BY name, set_release_date DESC, local_number_sort, local_id
LIMIT :limit OFFSET :offset;

-- Search cards by name using FTS5 unicode61 tokenizer (accent-insensitive)
searchCardsByNameFts:
SELECT cws.*
FROM cards_fts
INNER JOIN card_with_set cws
    ON cws.id = cards_fts.card_id
    AND cws.language = cards_fts.language
WHERE cards_fts.language = :language
    AND cards_fts MATCH :query
ORDER BY cws.name, cws.set_release_date DESC, cws.local_number_sort, cws.local_id
LIMIT :limit OFFSET :offset;

-- Count cards matching a name search
countCardsByName:
SELECT COUNT(*)
FROM cards
WHERE language = :language AND lower(name) LIKE '%' || lower(:query) || '%';

-- =============================================================================
-- ILLUSTRATOR & RARITY QUERIES
-- =============================================================================

-- Get all illustrators (language-agnostic)
getAllIllustrators:
SELECT *
FROM illustrators
ORDER BY name;

-- Get illustrator by ID
getIllustratorById:
SELECT *
FROM illustrators
WHERE id = :id;

-- Get all rarities (language-agnostic)
getAllRarities:
SELECT *
FROM rarities
ORDER BY name;

-- Get rarity by ID
getRarityById:
SELECT *
FROM rarities
WHERE id = :id;

-- Count cards per illustrator (for a specific language)
countCardsPerIllustrator:
SELECT
    illustrators.id,
    illustrators.name,
    COUNT(cards.id) AS card_count
FROM illustrators
LEFT JOIN cards ON cards.illustrator_id = illustrators.id AND cards.language = :language
GROUP BY illustrators.id, illustrators.name
HAVING card_count > 0
ORDER BY card_count DESC, illustrators.name;

-- Lightweight rows for illustrator aggregation (owned/total counts)
-- Excludes TCGP cards
getCardIdsByLanguage:
SELECT
    id AS card_id,
    illustrator_id,
    rarity_id,
    set_release_date,
    set_id,
    local_id,
    category
FROM card_with_set
WHERE language = :language
    AND serie_id != 'tcgp'
    AND illustrator_id IS NOT NULL
ORDER BY illustrator_id, id;

-- Sum embedded bestPrice per illustrator for value sort.
-- Uses bestPrice priority: trend -> avg -> low.
getIllustratorValueSumByLanguage:
SELECT
    illustrator_id,
    SUM(COALESCE(price_cardmarket_trend, price_cardmarket_avg, price_cardmarket_low, 0.0)) AS total_value
FROM card_with_set
WHERE language = :language
    AND serie_id != 'tcgp'
    AND illustrator_id IS NOT NULL
GROUP BY illustrator_id;

-- =============================================================================
-- POKÉMON DEX QUERIES (Pokédex collection support)
-- Uses card_with_pokemon view to support multi-Pokémon cards (TAG TEAMs, etc.)
-- =============================================================================

-- Get all unique Pokémon dex IDs with card counts and evolution data for a language
-- Returns: dexId, canonical species name (from pokemon_species table), total card count, evolution chain
-- Excludes TCGP (TCG Pocket) cards via serie_id filter
-- Note: A card with multiple dex IDs (e.g., TAG TEAM) is counted once per dex ID
-- Note: Uses COALESCE to fall back to card name if species table is missing entry
getAllPokemonDexIds:
SELECT
    cwp.pokemon_dex_id AS dex_id,
    COALESCE(ps.name, MIN(cwp.name)) AS pokemon_name,
    COUNT(*) AS card_count,
    ps.evolves_from,
    ps.evolves_to
FROM card_with_pokemon cwp
LEFT JOIN pokemon_species ps ON ps.dex_id = cwp.pokemon_dex_id AND ps.language = cwp.language
WHERE cwp.pokemon_dex_id IS NOT NULL
    AND cwp.language = :language
    AND cwp.serie_id != 'tcgp'
GROUP BY cwp.pokemon_dex_id
ORDER BY cwp.pokemon_dex_id ASC;

-- Get all card IDs grouped by Pokémon dex ID
-- Used for computing owned card counts in the Pokédex list
-- Excludes TCGP (TCG Pocket) cards
getAllCardIdsByPokemon:
SELECT
    pokemon_dex_id AS dex_id,
    id AS card_id
FROM card_with_pokemon
WHERE pokemon_dex_id IS NOT NULL
    AND language = :language
    AND serie_id != 'tcgp'
ORDER BY pokemon_dex_id ASC;

-- Get a Pokémon species by dex ID with evolution data
-- Returns: name, evolvesFrom, evolvesTo for the specified dexId and language
getPokemonSpeciesByDexId:
SELECT
    dex_id,
    name,
    evolves_from,
    evolves_to
FROM pokemon_species
WHERE dex_id = :dexId AND language = :language;

-- Get Pokémon species rows for a batch of dex IDs with evolution data
getPokemonSpeciesByDexIds:
SELECT
    dex_id,
    name,
    evolves_from,
    evolves_to
FROM pokemon_species
WHERE dex_id IN ?
    AND language = :language;

-- Get card counts per set for a specific Pokémon (for gallery grouping)
-- Returns: setId, setName, releaseDate, serieId, serieName, logoUrl, cardCount
getCardCountsPerSetForDexId:
SELECT
    set_id,
    set_name,
    set_release_date AS release_date,
    serie_id,
    serie_name,
    set_logo_url AS logo_url,
    set_symbol_url AS symbol_url,
    COUNT(*) AS card_count
FROM card_with_pokemon
WHERE pokemon_dex_id = :dexId
    AND language = :language
    AND serie_id != 'tcgp'
GROUP BY set_id, set_name, set_release_date, serie_id, serie_name, set_logo_url, set_symbol_url
ORDER BY set_release_date DESC, set_id;

-- Get all cards for a Pokémon in a specific set (for gallery rendering)
getCardsForDexIdInSet:
SELECT *
FROM card_with_pokemon
WHERE pokemon_dex_id = :dexId
    AND set_id = :setId
    AND language = :language
    AND serie_id != 'tcgp'
ORDER BY local_number_sort, local_id;

-- Get Pokémon dex ID for a specific card (reverse lookup for species)
-- Returns the first dex ID associated with the card (multi-Pokémon cards may have several)
-- Used by dashboard stats to resolve species from owned card IDs
getDexIdForCard:
SELECT pokemon_dex_id
FROM card_with_pokemon
WHERE id = :cardId
    AND language = :language
    AND pokemon_dex_id IS NOT NULL
LIMIT 1;

-- Batch dex lookup for multiple card IDs (used by dashboard stats).
-- Returns one row per (cardId, dexId) match; callers may collapse to Map and/or distinct dex IDs.
getDexIdsForCards:
SELECT id, pokemon_dex_id
FROM card_with_pokemon
WHERE id IN ?
    AND language = :language
    AND pokemon_dex_id IS NOT NULL;

-- =============================================================================
-- LOCAL ID / REFERENCE SEARCH QUERIES
-- Used for numeric reference searches like "001/165", "sv08-001", "sv08 001"
-- =============================================================================

-- Search cards by local_id (exact match, across all sets)
-- Excludes TCGP cards
searchCardsByLocalId:
SELECT *
FROM card_with_set
WHERE language = :language
    AND local_id = :localId
    AND serie_id != 'tcgp'
ORDER BY set_release_date DESC, set_id, local_number_sort
LIMIT :limit;

-- Search cards by local_id within a specific set
-- Excludes TCGP cards
searchCardsByLocalIdInSet:
SELECT *
FROM card_with_set
WHERE language = :language
    AND set_id = :setId
    AND local_id = :localId
    AND serie_id != 'tcgp'
ORDER BY local_number_sort;

-- Find sets by official card count (for matching "X/Y" format where Y is the count)
-- Excludes TCGP sets
findSetsByCardCount:
SELECT *
FROM sets
INNER JOIN series ON series.id = sets.serie_id AND series.language = sets.language
WHERE sets.language = :language
    AND sets.card_count_official = :cardCount
    AND sets.serie_id != 'tcgp'
ORDER BY sets.release_date DESC;

-- Search cards by local_id within sets matching a specific card count
-- Used for "001/165" format searches
-- Excludes TCGP cards
searchCardsByLocalIdAndCardCount:
SELECT cws.*
FROM card_with_set cws
INNER JOIN sets s ON s.id = cws.set_id AND s.language = cws.language
WHERE cws.language = :language
    AND cws.local_id = :localId
    AND s.card_count_official = :cardCount
    AND cws.serie_id != 'tcgp'
ORDER BY cws.set_release_date DESC, cws.set_id, cws.local_number_sort
LIMIT :limit;

-- Search sets by name (partial match, for "151" matching "Pokémon 151")
-- Excludes TCGP sets
searchSetsByName:
SELECT
    sets.*,
    series.name AS serie_name
FROM sets
INNER JOIN series ON series.id = sets.serie_id AND series.language = sets.language
WHERE sets.language = :language
    AND lower(sets.name) LIKE '%' || lower(:query) || '%'
    AND sets.serie_id != 'tcgp'
ORDER BY sets.release_date DESC
LIMIT :limit;

-- =============================================================================
-- RARITY AGGREGATION QUERIES
-- Used for rarity debug screen - aggregates rarity data per series
-- =============================================================================

-- Get rarities grouped by series with card counts and sample card ID
-- Returns aggregated data to avoid loading all cards (~10k+) into memory
-- Excludes TCGP (TCG Pocket) cards
getRaritiesGroupedBySeries:
SELECT
    series.id AS series_id,
    series.name AS series_name,
    series.position AS series_position,
    cards.rarity_id,
    rarities.name AS rarity_name,
    COUNT(*) AS card_count,
    MIN(cards.id) AS sample_card_id
FROM cards
INNER JOIN sets ON sets.id = cards.set_id AND sets.language = cards.language
INNER JOIN series ON series.id = sets.serie_id AND series.language = sets.language
LEFT JOIN rarities ON rarities.id = cards.rarity_id
WHERE cards.language = :language
    AND series.id != 'tcgp'
GROUP BY series.id, series.name, series.position, cards.rarity_id, rarities.name
ORDER BY series.position DESC, cards.rarity_id;

-- Get rarities grouped by series AND set with card counts
-- Returns hierarchical data: Series -> Set -> Rarity
-- Excludes TCGP (TCG Pocket) cards
getRaritiesGroupedBySeriesAndSet:
SELECT
    series.id AS series_id,
    series.name AS series_name,
    series.position AS series_position,
    sets.id AS set_id,
    sets.name AS set_name,
    sets.release_date AS set_release_date,
    cards.rarity_id,
    rarities.name AS rarity_name,
    COUNT(*) AS card_count
FROM cards
INNER JOIN sets ON sets.id = cards.set_id AND sets.language = cards.language
INNER JOIN series ON series.id = sets.serie_id AND series.language = sets.language
LEFT JOIN rarities ON rarities.id = cards.rarity_id
WHERE cards.language = :language
    AND series.id != 'tcgp'
GROUP BY series.id, series.name, series.position, sets.id, sets.name, sets.release_date, cards.rarity_id, rarities.name
ORDER BY series.position DESC, sets.release_date DESC, cards.rarity_id;
